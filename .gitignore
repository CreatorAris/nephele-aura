# Vendor push config files carry live keys/secrets — provide locally, never
# publish to this public repo. agconnect-services.json was purged from history
# (its client_secret leaked); both are gitignored so they can't be re-added.
google-services.json
agconnect-services.json
agconnect-services.json.keep
