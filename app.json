{
  "expo": {
    "name": "Nephele",
    "slug": "nephele-workshop",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "scheme": "nephele",
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "updates": {
      "url": "https://api.arisfusion.com/v1/aura/ota/manifest",
      "enabled": true,
      "fallbackToCacheTimeout": 0,
      "checkAutomatically": "NEVER",
      "requestHeaders": {
        "expo-channel-name": "production"
      }
    },
    "splash": {
      "image": "./assets/splash-blank.png",
      "resizeMode": "contain",
      "backgroundColor": "#1A1438"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.creatoraris.nephele.aura"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#1A1438"
      },
      "edgeToEdgeEnabled": true,
      "usesCleartextTraffic": true,
      "softwareKeyboardLayoutMode": "resize",
      "package": "com.creatoraris.nephele.aura",
      "permissions": [
        "android.permission.REQUEST_INSTALL_PACKAGES"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-asset",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-blank.png",
          "imageWidth": 180,
          "resizeMode": "contain",
          "backgroundColor": "#1A1438"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Nephele 需要相册权限以选图导入到桌面素材库。",
          "cameraPermission": "Nephele 需要相机权限以拍照导入到桌面素材库。"
        }
      ],
      [
        "expo-share-intent",
        {
          "androidIntentFilters": [
            "image/*"
          ],
          "androidMultiIntentFilters": [
            "image/*"
          ]
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Nephele 需要相机权限以扫描桌面二维码登录。"
        }
      ],
      "./plugins/withReleaseSigning",
      "./plugins/withJPush",
      "./plugins/withHmsPush",
      "./plugins/withFcm",
      "./plugins/withBlockedPermissions",
      "expo-secure-store"
    ],
    "extra": {
      "jpushAppKey": "e61a2780f1c7a0072ff5d4f0"
    }
  }
}
